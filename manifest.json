{
  "manifest_version": 3,
  "name": "poeticAd",
  "version": "0.5",
  "description": "Cover ads with a sonnet",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
  "action": {
    "default_icon": {
      "16": "assets/bard-logo.png",
      "24": "assets/bard-logo.png",
      "32": "assets/bard-logo.png"
    },
    "default_title": "My YT Bookmarks",
    "default_popup": "popup.html"
  }
}
